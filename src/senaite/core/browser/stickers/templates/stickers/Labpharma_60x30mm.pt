<tal:sticker define="item python:view.current_item;
                     sample_id item/getId;
                     sample_point item/getSamplePointTitle|nothing;
                     sample_type item/getSampleTypeTitle|nothing;
                     date_sampled python:view.ulocalized_time(item.getDateSampled());
                     date_expiration python:view.ulocalized_time(item.getField('DateExpiration').get(item)) if item.getField('DateExpiration').get(item) else '';
                     date_manufactured python:view.ulocalized_time(item.getField('Datemanufactured').get(item)) if item.getField('Datemanufactured').get(item) else '';
                     sampling_date python:view.ulocalized_time(item.getSamplingDate());
                     client_sample_id item/getClientSampleID|nothing;
                     client_order_num item/getClientOrderNumber|nothing; 
                     client_lot item/getLotClient|nothing;
                     internal_batch item/getBatchID|nothing;
                     preservation python:item.getEnvironmentalConditions();
                     analyses python:item.getAnalyses(full_objects=True);
                     hazardous python: 'Sim' if item.getField('Hazardous').get(item) else 'Não';
                     destination python:'Sim' if item.getField('destinationSample').get(item) else 'Não';
                     unicSample python:'Sim' if item.getField('unicSample').get(item) else 'Não';
                     field_analyses python:[analysis for analysis in analyses if analysis.getPointOfCapture()=='field'];">


  <table cellpadding="0" cellspacing="0" class="info-container">
    <tr>
      <th i18n:translate="">ID da Amostra</th>
      <td><strong tal:content="string:${sample_id}"/></td>
      <th i18n:translate="">Perigo</th>
      <td tal:content="hazardous"/>
    </tr>
    <tr>
      <th i18n:translate="">Data de Amostragem</th>
      <td tal:content="date_sampled"/>
      <th i18n:translate="">Amostragem</th>
      <td tal:content="sample_point"/>
    </tr>
    <tr>
      <th i18n:translate="">Nome da Amostra</th>
      <td tal:content="client_sample_id"/>
      <th i18n:translate="">Orçamento</th>
      <td tal:content="client_order_num"/>
    </tr>
    <tr>
      <th i18n:translate="">Tipo da Amostra</th>
      <td tal:content="sample_type"/>
      <th i18n:translate="">Condições Amb.</th>
      <td tal:content="preservation"/>
    </tr>
    <tr>
      <th i18n:translate="">Lote Cliente</th>
      <td tal:content="client_lot"/>
      <th i18n:translate="">Lote Interno</th>
      <td tal:content="internal_batch"/>
    </tr>
    <tr>
      <th i18n:translate="">Data de Val.</th>
      <td tal:content="date_expiration"/>
      <th i18n:translate="">Data de Fab.</th>
      <td tal:content="date_manufactured"/>
    </tr>
    <tr>
      <th i18n:translate="">Devolução</th>
      <td tal:content="destination"/>
      <th i18n:translate="">Amostra única</th>
      <td tal:content="unicSample"/>
    </tr>
<tr>
      <td colspan="4" class="footer-container">
        <table width="100%" style="border: none; table-layout: fixed;">
          <tr>
            <td style="width: 25%; text-align: left; vertical-align: middle;">
              <img tal:attributes="src string:${context/absolute_url}/logo.png" 
                   style="max-width: 50px; height: auto;" 
                   alt="Logo"/>
            </td>

            <td style="width: 50%; text-align: center; vertical-align: middle;">
              <div class="barcode"
                   tal:attributes="data-id sample_id;"
                   data-barHeight="10"
                   data-code="code39"
                   data-addQuietZone="true"
                   data-showHRI="false">
              </div>
              <small style="font-size: 6pt;" tal:content="sample_id"></small>
            </td>

            <td style="width: 25%; text-align: right; vertical-align: middle;">
              <div class="qrcode"
                   data-size="30"
                   data-render="image"
                   tal:attributes="data-text sample_id;">
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</tal:sticker>
